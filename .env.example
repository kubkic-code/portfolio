# ==============================================================================
# .env.example — Konfigurace prostředí pro kubkic-portfolio
# ==============================================================================
# Tento soubor slouží jako šablona. 
# Zkopírujte tento soubor jako `.env` a doplňte vlastní hodnoty:
#   cp .env.example .env (Linux / macOS / Git Bash)
#   copy .env.example .env (Windows cmd)
#
# DŮLEŽITÉ: Soubor `.env` obsahuje tajné klíče a je ignorován v .gitignore.
# NIKDY soubor `.env` nenahrávejte do veřejného Git repozitáře!
# ==============================================================================

# --- Server Configuration ---
PORT=5000
FLASK_DEBUG=false
FLASK_ENV=production

# --- Telegram Notifier (pro kontaktní formulář / alerty) ---
# Token bota získaný od @BotFather na Telegramu
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID kam mají chodit notifikace (získáte např. přes @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here
