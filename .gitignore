# ==============================================================================
# .gitignore — kubkic-portfolio
# ==============================================================================

# --- Prostředí a citlivá data (Secrets & Keys) ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
id_rsa*
secrets/
*.token

# --- Virtuální prostředí (Python venv) ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testování a Coverage ---
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- Logy a databáze ---
*.log
local_cache.db
*.sqlite
*.sqlite3
*.db

# --- IDE & Vývojové nástroje ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Operační systémy (OS specific) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Antigravity Agent & AI Cache ---
.agents/
.gemini/
